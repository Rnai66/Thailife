  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1190776448}
  m_Text: "1. \u0E27\u0E31\u0E14\u0E1E\u0E23\u0E30\u0E21\u0E2B\u0E32\u0E18\u0E32\u0E15\u0E38\u0E27\u0E23\u0E21\u0E2B\u0E32\u0E27\u0E34\u0E2B\u0E32\u0E23\n2. \u0E28\u0E32\u0E25\u0E2B\u0E25\u0E31\u0E01\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E19\u0E04\u0E23\u0E28\u0E23\u0E35\u0E18\u0E23\u0E23\u0E21\u0E23\u0E32\u0E0A\n3. \u0E2B\u0E2D\u0E1E\u0E23\u0E30\u0E1E\u0E38\u0E17\u0E18\u0E2A\u0E34\u0E2B\u0E34\u0E07\u0E04\u0E4C\n4. \u0E01\u0E33\u0E41\u0E1E\u0E07\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E40\u0E01\u0E48\u0E32 \u0E1B\u0E23\u0E30\u0E15\u0E39\u0E0A\u0E31\u0E22\u0E40\u0E2B\u0E19\u0E37\u0E2D\n5. \u0E2B\u0E2D\u0E1E\u0E23\u0E30\u0E2D\u0E34\u0E28\u0E27\u0E23 \u0E40\u0E2A\u0E32\u0E0A\u0E34\u0E07\u0E0A\u0E49\u0E32\n6. \u0E1A\u0E49\u0E32\u0E19\u0E2B\u0E19\u0E31\u0E07\u0E15\u0E30\u0E25\u0E38\u0E07\n7. \u0E15\u0E25\u0E32\u0E14\u0E2B\u0E31\u0E27\u0E2D\u0E34\u0E10\n8. \u0E2B\u0E21\u0E39\u0E48\u0E1A\u0E49\u0E32\u0E19\u0E04\u0E35\u0E23\u0E35\u0E27\u0E07\n9. \u0E19\u0E49\u0E33\u0E15\u0E01\u0E01\u0E23\u0E38\u0E07\u0E0A\u0E34\u0E07\n10. \u0E2D\u0E48\u0E32\u0E27\u0E02\u0E19\u0E2D\u0E21"
