--- !u!102 &706720973
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 706720970}
  m_Text: "1. \u0E2A\u0E19\u0E32\u0E21\u0E0A\u0E49\u0E32\u0E07 \u0E2D\u0E34\u0E19\u0E40\u0E15\u0E2D\u0E23\u0E4C\u0E40\u0E19\u0E0A\u0E31\u0E48\u0E19\u0E41\u0E19\u0E25\u0E40\u0E0B\u0E2D\u0E23\u0E4C\u0E01\u0E34\u0E15\n2. \u0E0A\u0E49\u0E32\u0E07 \u0E2D\u0E32\u0E23\u0E35\u0E19\u0E48\u0E32\n3. \u0E1B\u0E23\u0E32\u0E2A\u0E32\u0E17\u0E2B\u0E34\u0E19\u0E1E\u0E19\u0E21\u0E23\u0E38\u0E49\u0E07\n4. \u0E1B\u0E23\u0E32\u0E2A\u0E32\u0E17\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E15\u0E48\u0E33\n5. \u0E27\u0E19\u0E2D\u0E38\u0E17\u0E22\u0E32\u0E19\u0E40\u0E02\u0E32\u0E01\u0E23\u0E30\u0E42\u0E14\u0E07\n6. \u0E28\u0E32\u0E25\u0E2B\u0E25\u0E31\u0E01\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E1A\u0E38\u0E23\u0E35\u0E23\u0E31\u0E21\u0E22\u0E4C\n7. \u0E27\u0E31\u0E14\u0E40\u0E02\u0E32\u0E2D\u0E31\u0E07\u0E04\u0E32\u0E23\n8. \u0E17\u0E38\u0E48\u0E07\u0E19\u0E01\u0E01\u0E23\u0E30\u0E40\u0E23\u0E35\u0E22\u0E19 \u0E2B\u0E49\u0E27\u0E22\u0E08\u0E23\u0E30\u0E40\u0E02\u0E49\u0E21\u0E32\u0E01\n9. \u0E15\u0E25\u0E32\u0E14\u0E1C\u0E49\u0E32\u0E44\u0E2B\u0E21\u0E19\u0E32\u0E42\u0E1E\u0E18\u0E34\u0E4C\n10. \u0E16\u0E19\u0E19\u0E04\u0E19\u0E40\u0E14\u0E34\u0E19\u0E40\u0E0B\u0E23\u0E32\u0E30\u0E01\u0E23\u0E32\u0E27"
  m_OffsetZ: 0
  m_CharacterSize: 0.019
  m_LineSpacing: 1.1
  m_Anchor: 0
