  m_Script: {fileID: 11500000, guid: bf039394b5e2a4832a48014026b1b5f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SignPost
  title: "\u0E41\u0E1C\u0E19\u0E17\u0E35\u0E48\u0E17\u0E48\u0E2D\u0E07\u0E40\u0E17\u0E35\u0E48\u0E22\u0E27 \u0E08\u0E31\u0E07\u0E2B\u0E27\u0E31\u0E14\u0E2A\u0E07\u0E02\u0E25\u0E32"
  details: "1. \u0E41\u0E2B\u0E25\u0E21\u0E2A\u0E21\u0E34\u0E2B\u0E25\u0E32 \xB7 \u0E19\u0E32\u0E07\u0E40\u0E07\u0E37\u0E2D\u0E01\u0E17\u0E2D\u0E07\n2. \u0E40\u0E01\u0E32\u0E30\u0E2B\u0E19\u0E39 \u0E40\u0E01\u0E32\u0E30\u0E41\u0E21\u0E27\n3. \u0E22\u0E48\u0E32\u0E19\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E40\u0E01\u0E48\u0E32\u0E2A\u0E07\u0E02\u0E25\u0E32\n4. \u0E2A\u0E30\u0E1E\u0E32\u0E19\u0E15\u0E34\u0E13\u0E2A\u0E39\u0E25\u0E32\u0E19\u0E19\u0E17\u0E4C\n5. \u0E40\u0E02\u0E32\u0E15\u0E31\u0E07\u0E01\u0E27\u0E19\n6. \u0E1E\u0E23\u0E30\u0E1E\u0E38\u0E17\u0E18\u0E21\u0E07\u0E04\u0E25\u0E21\u0E2B\u0E32\u0E23\u0E32\u0E0A\n7. \u0E15\u0E25\u0E32\u0E14\u0E01\u0E34\u0E21\u0E2B\u0E22\u0E07\n8. \u0E1B\u0E49\u0E2D\u0E21\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E2A\u0E07\u0E02\u0E25\u0E32\n9. \u0E19\u0E49\u0E33\u0E15\u0E01\u0E42\u0E15\u0E19\u0E07\u0E32\u0E0A\u0E49\u0E32\u0E07\n10. \u0E28\u0E32\u0E25\u0E2B\u0E25\u0E31\u0E01\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E2A\u0E07\u0E02\u0E25\u0E32"
