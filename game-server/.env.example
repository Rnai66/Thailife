# Copy to .env and change these before letting other devices connect.
POSTGRES_PASSWORD=localdb
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=password
NAKAMA_SESSION_KEY=defaultencryptionkey
NAKAMA_REFRESH_KEY=defaultrefreshencryptionkey
NAKAMA_HTTP_KEY=defaulthttpkey
NAKAMA_CONSOLE_SIGNING_KEY=defaultsigningkey
# Dev only: keep the temple fair (chicken contest) open all the time
FAIR_ALWAYS_OPEN=false
# Dev only: keep the pubs open outside 19:00-03:00 game time
PUBS_ALWAYS_OPEN=false

# Testing only: markets (ตลาดสด 05-13, ตลาดนัด 16-22) open at any hour
MARKETS_ALWAYS_OPEN=false

# Testing only: งานตำบล / ชิงแชมป์ boxing events open every day (งานวัด follows FAIR_ALWAYS_OPEN)
BOXING_ALWAYS_OPEN=false
# (BOXING_ALWAYS_OPEN also skips the level / camp-membership requirement, for testing)
# Paid random-prize fair games (สอยดาว บิงโก มหาลัย ก.ไก่ ปาโป่ง). Off for the App Store: Apple treats them
# as simulated gambling, which individual developer accounts may not publish
CHANCE_GAMES=false
