# Copy to .env.prod on the server and fill in (gen-secrets.sh fills the keys for you).
# Never commit .env.prod. NAKAMA_SERVER_KEY must also go into the game's NakamaConfig.asset.
DOMAIN=game.example.com
POSTGRES_PASSWORD=
NAKAMA_SERVER_KEY=
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_SESSION_KEY=
NAKAMA_REFRESH_KEY=
NAKAMA_HTTP_KEY=
NAKAMA_CONSOLE_SIGNING_KEY=
